# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored. Leave this template empty and never commit secrets.
#
# These names have no NEXT_PUBLIC_ prefix, so Next.js exposes them only to
# server code (route handlers). The browser bundle cannot read them.

# Strava API application: https://www.strava.com/settings/api
# Authorization Callback Domain for local dev: localhost
# STRAVA_REDIRECT_URI must be the full callback URL, not just the domain.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=

# Postgres connection string (Neon, Vercel Postgres, or Supabase).
# Leave this empty to use the JSON file at .data/store.json instead.
# On Vercel, the Neon integration sets DATABASE_URL (pooled, for the app)
# and DATABASE_URL_UNPOOLED (direct, for CREATE TABLE). Do not paste those
# values into this file.
DATABASE_URL=
# DATABASE_URL_UNPOOLED=

# Optional path for the JSON fallback. Default is .data/store.json.
# CITY_STORE_PATH=
