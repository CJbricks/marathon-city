# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored. Leave this template empty and never commit secrets.
#
# These names have no NEXT_PUBLIC_ prefix, so Next.js exposes them only to
# server code (Server Components and route handlers). The browser bundle
# cannot read them. The Strava client secret has to stay server-side.

# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Must match the callback you register on the Strava app.
# Local example: http://localhost:3000/api/strava/callback
STRAVA_REDIRECT_URI=

# Vercel Postgres or Supabase connection string.
DATABASE_URL=
